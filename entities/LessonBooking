{
  "name": "LessonBooking",
  "type": "object",
  "properties": {
    "parent_name": {
      "type": "string",
      "description": "Parent or guardian full name"
    },
    "parent_email": {
      "type": "string",
      "description": "Parent or guardian email address"
    },
    "parent_phone": {
      "type": "string",
      "description": "Parent or guardian phone number"
    },
    "child_name": {
      "type": "string",
      "description": "Child's name"
    },
    "child_age": {
      "type": "number",
      "description": "Child's age"
    },
    "lesson_type": {
      "type": "string",
      "enum": [
        "Private",
        "Semi-Private",
        "Mommy & Me",
        "Gift"
      ],
      "description": "Type of lesson"
    },
    "lesson_duration": {
      "type": "string",
      "enum": [
        "30 min",
        "60 min"
      ],
      "description": "Duration of the lesson"
    },
    "water_comfort_level": {
      "type": "number",
      "description": "Child's water comfort level from 1 to 5"
    },
    "water_comfort_label": {
      "type": "string",
      "enum": [
        "Never been in water",
        "Nervous but willing",
        "Comfortable with floaties",
        "Can swim a little",
        "Confident swimmer"
      ],
      "description": "Description of child's water comfort"
    },
    "lesson_date": {
      "type": "string",
      "format": "date",
      "description": "Booked lesson date"
    },
    "lesson_time": {
      "type": "string",
      "description": "Booked lesson time slot"
    },
    "additional_notes": {
      "type": "string",
      "description": "Any special needs or notes"
    },
    "waiver_agreed": {
      "type": "boolean",
      "description": "Liability waiver agreed"
    },
    "waiver_signature": {
      "type": "string",
      "description": "Digital signature (typed name)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "pending",
      "description": "Booking status"
    }
  },
  "required": [
    "parent_name",
    "parent_email",
    "child_name",
    "child_age",
    "water_comfort_level",
    "lesson_date",
    "lesson_time"
  ]
}